# Copy this file to .env and fill it in:  cp .env.example .env
# .env is git-ignored. Ask your supervisor for the values marked "ask".

# --- you ---
APPNAME=yourname-gpu            # pod/image name, lowercase letters, digits and "-" only; must be unique
APPVERSION=0.1                  # bump this whenever you rebuild
USERNAME=yourname               # Linux user inside the container
USER_UID=                       # ask: your cluster user id (needed for file permissions on the shared storage)
USER_GID=1735                   # ask: group id
GIT_NAME="Your Name"
GIT_EMAIL=you@example.com

# --- cluster ---
NAMESPACE=imsb
REMOTE_REGISTRY=                # ask: container registry host, e.g. registry.example.org/imsb

# --- storage, mounted at /data (ask) ---
# Either a volume (PersistentVolumeClaim) ...
DATA_PVC=                       # e.g. pvc-my-data
# ... or an NFS share (leave DATA_PVC empty then):
DATA_NFS_SERVER=                # e.g. my-nfs-server
DATA_NFS_PATH=                  # e.g. /export/path/
# Optional: only mount this folder inside the storage, e.g. students/yourname. Empty = all of it.
DATA_SUBPATH=

# --- resources the pod asks for ---
CPU=8
MEMORY=32Gi                     # going over this kills the pod
GPU=1
